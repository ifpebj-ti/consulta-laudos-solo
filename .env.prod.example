# Ambiente de produção — copie para .env.prod e preencha os valores
ENVIRONMENT=production

# Chave secreta para assinatura dos tokens JWT (mínimo 32 caracteres)
JWT_SECRET_KEY=

# ID do cliente OAuth 2.0 do Google Cloud Console
GOOGLE_CLIENT_ID=

# Token de autenticação para o endpoint administrativo /api/admin/
# OBRIGATÓRIO em produção — gere com: openssl rand -hex 32
ADMIN_TOKEN=

# Senha do administrador do Grafana
GRAFANA_ADMIN_PASSWORD=
