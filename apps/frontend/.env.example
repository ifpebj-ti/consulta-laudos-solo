# URL base da API. Em desenvolvimento o padrão é http://localhost:8080/api.
# Em produção, se ficar vazia, o frontend usa /api no mesmo domínio (proxy do Nginx).
VITE_API_BASE_URL=http://localhost:8080/api

# Client ID do Google Identity Services usado no login do analista.
# Em desenvolvimento pode ficar vazio: aparece o botão "Entrar como analista de teste" (mock do backend).
VITE_GOOGLE_CLIENT_ID=

# Ativa a listagem de amostras pelo servidor no Painel do Analista (GET /api/laudos).
# Deixe false enquanto o backend não expuser o endpoint descrito em docs/contrato-api.md.
VITE_FEATURE_LISTAGEM_SERVIDOR=false

# Ativa a homologação pelo servidor (POST /api/laudos/{protocolo}/homologar).
# Com false, em produção o botão de homologar fica desabilitado; em desenvolvimento a homologação é simulada no navegador.
VITE_FEATURE_HOMOLOGACAO_SERVIDOR=false

# Ativa o botão "Atualizar situação" e a atualização automática do laudo do cliente (GET /api/laudos/{protocolo}).
VITE_FEATURE_SITUACAO_CLIENTE=false
