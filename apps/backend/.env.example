# Ambiente de execução: dev | staging | production
ENVIRONMENT=dev

# Prefixo das rotas da API
API_PREFIX=/api

# Chave secreta para assinatura dos tokens JWT (mínimo 32 caracteres)
JWT_SECRET_KEY=chave-super-secreta-de-desenvolvimento-local-minimo-32-chars

# Google OAuth — obtenha em https://console.cloud.google.com/
GOOGLE_CLIENT_ID=

# Habilita autenticação mock em dev (NUNCA usar em produção)
ENABLE_MOCK_AUTH=true
